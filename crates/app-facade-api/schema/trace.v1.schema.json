{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linear execution trace",
  "type": "array",
  "maxItems": 256,
  "items": {
    "oneOf": [
      {
        "type": "object",
        "required": [
          "type",
          "timestamp",
          "userId",
          "source"
        ],
        "properties": {
          "type": {
            "const": "USER"
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0
          },
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "ui",
              "agent",
              "cli",
              "mcp",
              "messaging"
            ]
          },
          "appClientId": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "cardId": {
            "type": "string"
          },
          "surfaceId": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "type",
          "timestamp",
          "spaceId",
          "source"
        ],
        "properties": {
          "type": {
            "const": "SPACE"
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0
          },
          "spaceId": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "ui",
              "agent",
              "cli",
              "mcp",
              "messaging"
            ]
          },
          "appClientId": {
            "type": "string"
          },
          "page": {
            "type": "string"
          },
          "cardId": {
            "type": "string"
          },
          "surfaceId": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "type",
          "timestamp",
          "automationId"
        ],
        "properties": {
          "type": {
            "const": "AUTOMATION_IGNITE"
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0
