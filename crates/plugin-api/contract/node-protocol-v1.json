{
  "manifest": "mhome.node.protocol.v1",
  "pluginApi": {
    "version": "v1",
    "appTargetPrefix": "/app/plugin",
    "nodeRequestFields": ["nodeId", "version", "payload"],
    "nodeResponseFields": ["nodeId", "nodeType", "version", "data"],
    "settingsChangedTarget": "/plugin/settings/changed",
    "settingsChangedEventFields": [
      "version",
      "nodeId",
      "nodeType",
      "eventSeq",
      "section",
      "revision"
    ]
  },
  "llm": {
    "version": "v1",
    "runtimeTargetPrefix": "/llm/app/",
    "routes": {
      "modelImportStart": "model/import/start",
      "modelImportStatus": "model/import/status",
      "modelImportFinalize": "model/import/finalize",
      "modelImportCancel": "model/import/cancel"
    },
    "modelImportUploadPathPrefix": "/llm/model/import/upload",
    "modelImportUploadHeaders": {
      "authorization": "authorization",
      "offset": "x-upload-offset",
      "chunkSha256": "x-chunk-sha256"
    },
    "modelImportStartRequestFields": [
      "displayName",
      "fileName",
      "artifactSha256",
      "sizeBytes",
      "idempotencyKey"
    ],
    "modelImportOperationRequestFields": ["operationId"],
    "modelImportChunkResponseFields": [
      "ok",
      "operationId",
      "receivedBytes",
      "reason",
      "detail"
    ]
  },
  "audioBridge": {
    "version": "v1",
    "runtimeTargetPrefix": "/audiobridge/app/",
    "routes": {
      "deviceSnapshot": "device/snapshot",
      "deviceRefresh": "device/refresh",
      "deviceAdopt": "device/adopt",
      "deviceUnpair": "device/unpair",
      "deviceTest": "device/test"
    },
    "deviceRequestFields": ["deviceId"],
    "deviceFields": [
      "deviceId",
      "displayName",
      "transport",
      "online"
    ],
    "candidateFields": [
      "deviceId",
      "displayName",
      "transport"
    ]
  },
  "backendStatus": {
    "nodeContract": "baycat.node.status.v1",
    "contract": "baycat.backend.status.v1",
    "queryTarget": "/backend/status",
    "changedTarget": "/backend/status/changed",
    "resourceEnvelopeFields": [
      "contract",
      "scopeId",
      "hubGeneration",
      "hubRevision",
      "observedAtMs",
      "resource",
      "deleted",
      "snapshot"
    ],
    "resourceTypes": [
      "nodeInstance",
      "nodeRuntime",
      "managedService",
      "hubConnection",
      "scopeConnection"
    ]
  }
}
