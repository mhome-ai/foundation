{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mhome.ai/app-facade/facade-call.v1.schema.json",
  "title": "App Facade call",
  "type": "object",
  "additionalProperties": false,
  "required": ["control", "input"],
  "properties": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["direct", "prepare", "commit", "reject"] },
        "preparedActionId": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "approvalToken": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "responseFormat": { "enum": ["json", "text"] }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "enum": ["direct", "prepare"] } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["preparedActionId"] },
                { "required": ["approvalToken"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "mode": { "const": "commit" } } },
          "then": { "required": ["preparedActionId", "approvalToken"] }
        },
        {
          "if": { "properties": { "mode": { "const": "reject" } } },
          "then": {
            "required": ["preparedActionId"],
            "not": { "required": ["approvalToken"] }
          }
        }
      ]
    },
    "input": true
  }
}
