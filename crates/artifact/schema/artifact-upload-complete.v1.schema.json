{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schemas/artifact-upload-complete.v1.schema.json",
  "title": "Artifact upload complete",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploadId",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "uploadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          }
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "response": {
      "$ref": "#/$defs/metadata"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "kind",
        "mimeType",
        "sizeBytes"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^meow-artifact://v3/",
          "maxLength": 2048
        },
        "kind": {
          "enum": [
            "IMAGE",
            "AUDIO",
            "VIDEO",
            "FILE"
          ]
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 1
        },
        "identity": {
          "enum": [
            "auto",
            "man"
          ],
          "default": "auto"
        },
        "retention": {
          "enum": [
            "std",
            "tmp"
          ],
          "default": "std"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "retention": {
                "const": "tmp"
              }
            },
            "required": [
              "retention"
            ]
          },
          "then": {
            "properties": {
              "expiresAtUnixMs": {}
            },
            "required": [
              "expiresAtUnixMs"
            ]
          },
          "else": {
            "not": {
              "properties": {
                "expiresAtUnixMs": {}
              },
              "required": [
                "expiresAtUnixMs"
              ]
            }
          }
        }
      ]
    }
  }
}
