  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "surfaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^cs1:(cp|cg):[A-Za-z0-9_-]+$"
        },
        "threadId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "controlVersion": {
          "type": "string",
          "pattern": "^[0-9]{20}:[0-9]{20}$"
        },
        "historyVersion": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        }
      },
      "required": [
        "ownerId",
        "scopeId",
        "surfaceId",
        "threadId",
        "controlVersion",
        "historyVersion"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submit": {
          "type": "boolean"
        },
        "answer": {
          "type": "boolean"
        },
        "transcribe": {
          "type": "boolean"
        },
        "speak": {
          "type": "boolean"
        },
        "unavailableReason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "submit",
        "answer",
        "transcribe",
        "speak",
        "unavailableReason"
      ]
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "batchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4096
        },
        "actionCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "complete": {
          "type": "boolean"
        },
        "canApprove": {
          "type": "boolean"
        }
      },
      "required": [
        "threadId",
        "requestId",
        "batchId",
        "text",
        "actionCount",
        "complete",
        "canApprove"
      ]
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "messageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "contentRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "previousOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "hasUnsupportedParts": {
          "type": "boolean"
        }
      },
      "required": [
        "threadId",
        "requestId",
        "messageId",
        "contentRevision",
        "offset",
        "nextOffset",
        "previousOffset",
        "text",
        "hasUnsupportedParts"
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "interaction_required",
            "interrupted",
            "agent_failed",
            "system_failed"
          ]
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 1024
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "errorCode",
        "message"
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "phase": {
          "enum": [
            "unknown",
            "idle",
            "queued",
            "running",
            "pending",
            "settled"
          ]
        },
        "activeRequestId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "queueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "pending": {
          "anyOf": [
            {
              "$ref": "#/$defs/pending"
            },
            {
              "type": "null"
            }
          ]
        },
        "reply": {
          "anyOf": [
            {
              "$ref": "#/$defs/reply"
            },
            {
              "type": "null"
            }
          ]
        },
        "settlement": {
          "anyOf": [
            {
              "$ref": "#/$defs/settlement"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "context",
        "capabilities",
        "phase",
        "activeRequestId",
        "queueCount",
        "pending",
        "reply",
        "settlement"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "settled"
              }
            }
          },
          "then": {
            "properties": {
              "settlement": {
                "$ref": "#/$defs/settlement"
              }
            }
          },
          "else": {
            "properties": {
              "settlement": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/context"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "admission": {
          "anyOf": [
            {
              "enum": [
                "waiting_handoff",
                "bound",
                "cancelled",
                "failed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "enum": [
            "unknown",
            "idle",
            "queued",
            "running",
            "pending",
            "settled"
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending": {
          "anyOf": [
            {
              "$ref": "#/$defs/pending"
            },
            {
              "type": "null"
            }
          ]
        },
        "reply": {
          "anyOf": [
            {
              "$ref": "#/$defs/reply"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "context",
        "requestId",
        "admission",
        "phase",
        "outcome",
        "pending",
        "reply"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "threadId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "enum": [
            "scheduled",
            "queued",
            "duplicate",
            "blocked_pending_interaction"
          ]
        }
      },
      "required": [
        "requestId",
        "threadId",
        "disposition"
      ]
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "phase",
        "outcome"
      ],
      "properties": {
        "requestId": {
          "$ref": "#/$defs/id"
        },
        "phase": {
          "enum": [
            "admission_waiting",
            "waiting",
            "running"
          ]
        },
        "outcome": {
          "enum": [
            "cancelled",
            "cancelling"
          ]
        },
        "queueVersion": {
          "type": "integer",
          "minimum": 0
        },
        "admissionVersion": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "changed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "scopeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "surfaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^cs1:(cp|cg):[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "ownerId",
        "scopeId",
        "surfaceId"
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "disposition": {
          "enum": [
            "accepted",
            "clarify",
            "resolved",
            "expired",
            "unsupported"
          ]
        }
      },
      "required": [
        "operationId",
        "disposition"
      ]
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploadId",
        "url",
        "headers",
        "expiresAtUnixMs"
      ],
      "properties": {
        "uploadId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 4096
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 512
          },
          "maxProperties": 8
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hostIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostId",
            "publicKey"
          ],
          "properties": {
            "hostId": {
              "type": "string",
              "minLength": 1
            },
            "publicKey": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "y": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                }
              }
            }
          }
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "kind",
        "mimeType",
        "sizeBytes",
        "delivery"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^meow-artifact://v3/",
          "maxLength": 2048
        },
        "kind": {
          "const": "AUDIO"
        },
        "mimeType": {
          "const": "audio/wav"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 44,
          "maximum": 1536044
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "delivery": {
