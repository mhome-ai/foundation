{
  "manifest": "mhome.app-facade.v1",
  "contractVersion": "1.135.0",
  "callSchema": "schema/facade-call.v1.schema.json",
  "routing": "manifest/routing.v1.json",
  "routingSchema": "schema/routing.v1.schema.json",
  "domains": {
    "artifact": {
      "contract": "mhome.artifact.v1",
      "requestTargets": [
        "/app/artifact/resolve",
        "/app/artifact/external/resolve",
        "/app/artifact/put",
        "/app/artifact/import",
        "/app/artifact/delete",
        "/app/artifact/upload/start",
        "/app/artifact/upload/complete",
        "/app/artifact/upload/cancel"
      ]
    },
    "hub": {
      "targets": "manifest/hub-targets.v1.json",
      "cloudStateTarget": "/app/hub/get",
      "nativeCompositeTarget": "/local/hub/get"
    },
    "messaging": {
      "targets": "manifest/targets.v1.json"
    },
    "pod": {
      "targets": "manifest/pod-targets.v1.json",
      "contract": "contract/pod-commissioning-v1.md",
      "listTarget": "/app/pod/list",
      "enrollmentTargets": [
        "/app/pod/enrollment/get",
        "/app/pod/space/enrollment/get"
      ],
      "renameTarget": "/app/pod/rename",
      "spaceInventoryTarget": "/app/pod/space/list",
      "directoryContract": "contract/pod-directory-v1.md"
    },
    "hostProvision": {
      "targets": "manifest/host-provision-targets.v1.json",
      "contract": "contract/host-provisioning-v1.md"
    },
    "plugin": {
      "extensionVersion": "v1",
      "targetPrefix": "/app/plugin",
      "catalogSchema": "schema/plugin-catalog.v1.schema.json",
      "exactRequestTargets": [
        "/app/plugin/catalog/list",
        "/app/plugin/enabled/list",
        "/app/plugin/detail/get",
        "/app/plugin/contribution/read",
        "/app/plugin/operations/list",
        "/app/plugin/operation/invoke",
        "/app/plugin/operation/submit",
        "/app/plugin/operation/status",
        "/app/plugin/candidate/list",
        "/app/plugin/enable/start",
        "/app/plugin/enable/status",
        "/app/plugin/disable",
        "/app/plugin/profile/update",
        "/app/plugin/install/prepare",
        "/app/plugin/install/start",
        "/app/plugin/install/status",
        "/app/plugin/preview/check"
      ],
      "eventTargets": [
        "/app/plugin/settings/changed"
      ],
      "extensionFamily": "/app/plugin/{nodeType}/{route...}",
      "extensionPriority": "after_exact",
      "installSchema": "schema/plugin-install.v1.schema.json",
      "installContract": "contract/plugin-install-v1.md",
      "previewContract": "contract/plugin-preview-v1.md"
    },
    "runtime": {
      "contract": "mhome.runtime.status.v1",
      "resourceTypes": [
        "nodeInstance",
        "nodeRuntime"
      ],
      "requestTargets": [
        "/app/runtime/status/list"
      ],
      "eventTargets": [
        "/app/runtime/status/changed"
      ]
    },
    "interactionFlow": {
      "schema": "schema/interaction-flow-app.v1.schema.json",
      "requestTargets": [
        "/app/interaction-flow/start",
        "/app/interaction-flow/resolve",
        "/app/interaction-flow/next",
        "/app/interaction-flow/back",
        "/app/interaction-flow/complete",
        "/app/interaction-flow/cancel",
        "/app/interaction-flow/submission/status",
        "/app/interaction-flow/submission/retry"
      ],
      "sessionPersistence": "memory"
    },
    "system": {
      "contract": "mhome.system.instances.v1",
      "schema": "schema/system-instances.v1.schema.json",
      "hostsContract": "mhome.system.hosts.v1",
      "hostsSchema": "schema/system-hosts.v1.schema.json",
      "hostsRuntimeContract": "mhome.system.hosts.runtime.v1",
      "hostsRuntimeSchema": "schema/system-hosts-runtime.v1.schema.json",
      "requestTargets": [
        "/app/system/instances/get",
        "/app/system/clients/get",
        "/app/system/hosts/get",
        "/app/system/hosts/runtime",
        "/app/system/hosts/permissions"
      ]
