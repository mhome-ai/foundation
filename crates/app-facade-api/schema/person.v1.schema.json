{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mhome.person.v1",
  "title": "Person management inputs",
  "$defs": {
    "ListInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": []
    },
    "IdInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "RevisionInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "expectedEpoch": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "expectedRevision",
        "expectedEpoch"
      ]
    },
    "ResetInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedEpoch": {
          "type": "string"
        }
      },
      "required": [
        "expectedEpoch"
      ]
    },
    "ExportInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "password": {
          "type": "string"
        }
      },
      "required": [
        "password"
      ]
    },
    "ReadInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "offset"
      ]
    },
    "ImportStart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "sizeBytes"
      ]
    },
    "ImportWrite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "dataBase64": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "offset",
        "dataBase64"
      ]
    },
    "ImportCommit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "expectedEpoch": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "password",
        "expectedEpoch"
      ]
    },
    "ClusterName": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "expectedRevision": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "expectedEpoch": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "representativeSampleId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "expectedRevision",
        "expectedEpoch",
        "name",
        "representativeSampleId"
      ]
    },
    "ImageInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "representativeSampleId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "representativeSampleId"
      ]
    }
  }
}
