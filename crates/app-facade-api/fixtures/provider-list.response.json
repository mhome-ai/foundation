{
  "target": "/app/messaging/provider/list",
  "direction": "response",
  "body": {
    "providers": [
      {
        "provider": "telegram",
        "displayName": "Telegram",
        "placement": "cloud",
        "deprecated": false,
        "available": true,
        "setupFlow": "pairing_code",
        "audiences": ["personal", "shared"],
        "inboundCapabilities": ["text", "audio", "action"],
        "outboundCapabilities": ["text", "markdown", "action"],
        "deliveryMode": "unrestricted",
        "projections": {
          "notification": { "supported": true },
          "dialog": { "supported": true }
        },
        "managementOperations": [
          "provider_account.list",
          "provider_account.status",
          "route.list",
          "route.update",
          "route.delete",
          "setup.options",
          "setup.start",
          "setup.status"
        ],
        "providerData": {}
      }
    ]
  }
}
