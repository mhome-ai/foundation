{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/entity-presentation.v1.schema.json",
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityType",
        "entityId"
      ],
      "properties": {
        "entityType": {
          "type": "string",
          "pattern": "\\S"
        },
        "entityId": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityEntry",
        "entityCard",
        "twinAutomations"
      ],
      "properties": {
        "entityEntry": {
          "type": "object",
          "required": [
            "uid",
            "type"
          ],
          "properties": {
            "uid": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "integration": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "entityCard": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "twinAutomations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "metaInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityType",
        "ids"
      ],
      "properties": {
        "entityType": {
          "type": "string",
          "pattern": "\\S"
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entityType",
        "displayName",
        "group"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "entityType": {
          "type": "string",
          "pattern": "\\S"
        },
        "displayName": {
          "type": "string"
        },
        "group": {
          "type": "boolean"
        }
      }
    },
    "metaItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestedId",
            "found",
            "resource"
          ],
          "properties": {
            "requestedId": {
              "type": "string",
              "pattern": "\\S"
            },
            "found": {
              "const": true
            },
            "resource": {
              "$ref": "#/$defs/metadata"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestedId",
            "found",
            "reason"
          ],
          "properties": {
            "requestedId": {
              "type": "string",
              "pattern": "\\S"
            },
            "found": {
              "const": false
            },
            "reason": {
              "const": "not_found"
            }
          }
        }
      ]
    },
    "metaOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/metaItem"
          }
        }
      }
    }
  }
}
