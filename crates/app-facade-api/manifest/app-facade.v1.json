        "/app/ui/customize/cards/catalog/package/update": "#/definitions/packageUpdate",
        "/app/ui/customize/cards/catalog/release/list": "#/definitions/packageGet",
        "/app/ui/customize/cards/catalog/release/get": "#/definitions/releaseGet",
        "/app/ui/customize/cards/catalog/publish/prepare": "#/definitions/publishPrepare",
        "/app/ui/customize/cards/catalog/publish/complete": "#/definitions/publishComplete",
        "/app/ui/customize/cards/selection/get": "#/definitions/empty",
        "/app/ui/customize/cards/install": "#/definitions/install",
        "/app/ui/customize/cards/uninstall": "#/definitions/uninstall",
        "/app/ui/customize/cards/upgrade": "#/definitions/upgrade",
        "/app/ui/customize/cards/override/set": "#/definitions/overrideSet",
        "/app/ui/customize/cards/override/reset": "#/definitions/overrideReset"
