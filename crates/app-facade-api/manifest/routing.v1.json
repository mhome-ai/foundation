{
  "manifest": "mhome.app-facade.routing.v1",
  "contractVersion": "1.46.0",
  "targetPrefix": "/app/",
  "default": {
    "execution": "scopeMode"
  },
  "matching": "exactBeforePrefix",
  "placementJsonPointer": "/input/placement",
  "rules": {
    "cloudPrefixes": [
      "/app/scope/",
      "/app/inspire/",
      "/app/user/"
    ],
    "cloudTargets": [
      "/app/agent/context/get",
      "/app/hub/cache/clear",
      "/app/hub/get",
      "/app/hub/remove",
      "/app/plugin/catalog/list",
      "/app/system/feedback/submit",
      "/app/timeline/entity/latest/list",
      "/app/host/access/issue",
      "/app/host/authorization"
    ],
    "scopeModeTargets": [
      "/app/artifact/resolve",
      "/app/scope/context/get",
      "/app/artifact/put",
      "/app/artifact/import",
      "/app/artifact/delete",
      "/app/artifact/upload/start",
      "/app/artifact/upload/complete",
      "/app/artifact/upload/cancel",
      "/app/system/instances/get",
      "/app/system/clients/get"
    ],
    "hubPrefixes": [
      "/app/plugin/",
      "/app/interaction-flow/",
      "/app/object-storage/",
      "/app/runtime/",
      "/app/system/hosts/",
      "/app/person/"
    ],
    "requestPlacementPrefixes": [
      "/app/messaging/"
    ],
    "hubTargets": [
      "/app/hub/restart",
      "/app/hub/status"
    ]
  }
}
