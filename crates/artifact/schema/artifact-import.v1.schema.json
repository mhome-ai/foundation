{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/artifact-import.v1.schema.json",
  "title": "MeowLink artifact import request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "sourceUrl"
  ],
  "properties": {
    "kind": {
      "enum": [
        "IMAGE",
        "AUDIO",
        "FILE"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?://",
      "minLength": 8
    },
    "mimeType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
      "not": {
        "pattern": "[^a-z0-9!#$&^_.+/\\-]"
      }
    },
    "creationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "identity": {
      "enum": [
        "auto",
        "man"
      ],
      "default": "auto"
    },
    "retention": {
      "enum": [
        "std",
        "tmp"
      ],
      "default": "std"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity": {
            "const": "man"
          }
        },
        "required": [
          "identity"
        ]
      },
      "then": {
        "required": [
          "creationId"
        ],
        "properties": {
          "creationId": {}
        }
      },
      "else": {
        "not": {
          "required": [
            "creationId"
          ],
          "properties": {
            "creationId": {}
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "IMAGE"
            },
            "mimeType": {
              "type": "string",
              "pattern": "^image/"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "AUDIO"
            },
            "mimeType": {
              "type": "string",
              "pattern": "^audio/"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "FILE"
            },
            "mimeType": {
              "type": "string",
              "not": {
                "pattern": "^video/"
              }
            }
          }
        }
      ]
    }
  ]
}
