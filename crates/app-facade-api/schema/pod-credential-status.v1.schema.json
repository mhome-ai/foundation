{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mhome.ai/app-facade/pod-credential-status.v1.schema.json",
  "title": "Lion pod credential status, as seen by the owning user",
  "type": "object",
  "required": ["podId", "status"],
  "properties": {
    "podId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "active", "absent"] },
    "activatedAt": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "active" } } },
      "then": { "required": ["activatedAt"] }
    }
  ]
}
