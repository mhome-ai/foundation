{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hostId",
    "sample"
  ],
  "properties": {
    "hostId": {
      "type": "string"
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "data",
        "observedAtMs",
        "lastAttemptAtMs",
        "stale",
        "errorCode"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "unsupported",
            "notQueried"
          ]
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hostId",
                "sampledAtMs",
                "cpuUsagePercent",
                "memoryAvailableBytes",
                "diskAvailableBytes",
                "networkReceivedBytesPerSecond",
                "networkSentBytesPerSecond",
                "services"
              ],
              "properties": {
                "hostId": {
                  "type": "string"
                },
                "sampledAtMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "cpuUsagePercent": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "memoryAvailableBytes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "diskAvailableBytes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "networkReceivedBytesPerSecond": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "networkSentBytesPerSecond": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "services": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "serviceId",
                      "status",
                      "sampleState",
                      "processCount",
                      "cpuUsagePercent",
                      "memoryResidentBytes",
                      "diskReadBytesPerSecond",
                      "diskWrittenBytesPerSecond"
                    ],
                    "properties": {
                      "serviceId": {
                        "type": "string"
                      },
                      "status": {
                        "type": "string"
                      },
                      "sampleState": {
                        "type": "string"
                      },
                      "processCount": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "cpuUsagePercent": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "memoryResidentBytes": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "diskReadBytesPerSecond": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "diskWrittenBytesPerSecond": {
                        "anyOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAtMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lastAttemptAtMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
