{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.meowlink.app/dashboard-card-authoring.v1.json",
  "definitions": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        }
      },
      "required": [
        "cardId"
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "patternId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "patternId"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "cardId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "canvasId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "title": {
          "type": "string"
        },
        "primaryViewId": {
          "type": [
            "string",
            "null"
          ]
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/view"
          }
        }
      },
      "required": [
        "spaceId",
        "cardId",
        "canvasId",
        "title",
        "primaryViewId",
        "views"
      ]
    }
  }
}
