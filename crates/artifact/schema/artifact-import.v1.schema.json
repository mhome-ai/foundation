{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/artifact-import.v1.schema.json",
  "title": "MeowLink artifact import request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "sourceUrl"
  ],
  "properties": {
    "kind": {
      "enum": [
        "IMAGE",
        "AUDIO",
        "FILE"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https?://",
      "minLength": 8
    },
    "mimeType": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "JPEG",
            "PNG"
          ]
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "maxHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "PNG"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "quality"
                  ]
                },
                {
                  "required": [
                    "background"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "transform"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "IMAGE"
          }
        }
      }
    }
  ]
}
