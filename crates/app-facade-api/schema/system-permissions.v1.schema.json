{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hostId",
    "snapshot"
  ],
  "properties": {
    "hostId": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "data",
        "observedAtMs",
        "lastAttemptAtMs",
        "stale",
        "errorCode"
      ],
      "properties": {
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "unsupported",
            "notQueried"
          ]
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hostId",
                "subjectId",
                "subjectName",
                "hostVersion",
                "platform",
                "observedAtMs",
                "permissions",
                "declarationErrors"
              ],
              "properties": {
                "hostId": {
                  "type": "string",
                  "minLength": 1
                },
                "subjectId": {
                  "type": "string",
                  "minLength": 1
                },
                "subjectName": {
                  "type": "string",
                  "minLength": 1
                },
                "hostVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "observedAtMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "permissions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "permission",
                      "state",
                      "evidence",
                      "observedAtMs",
                      "uses",
                      "supportedActions",
                      "error"
                    ],
                    "properties": {
                      "permission": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id"
                            ],
                            "properties": {
                              "id": {
                                "enum": [
                                  "localNetwork",
                                  "bluetooth",
                                  "microphone",
                                  "reminders"
                                ]
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "targetBundleId"
                            ],
                            "properties": {
                              "id": {
                                "const": "automation"
                              },
                              "targetBundleId": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        ]
                      },
                      "state": {
                        "enum": [
                          "unknown",
                          "notDetermined",
                          "granted",
                          "denied",
                          "restricted",
                          "unsupported"
                        ]
                      },
                      "evidence": {
                        "enum": [
                          "system",
                          "probe",
                          "unavailable"
                        ]
                      },
                      "observedAtMs": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "uses": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "componentId",
                            "componentName",
                            "feature",
                            "reason"
                          ],
                          "properties": {
                            "componentId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "componentName": {
                              "type": "string",
                              "minLength": 1
                            },
                            "feature": {
                              "type": "string",
                              "minLength": 1
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      },
                      "supportedActions": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "request",
                            "openSettings"
                          ]
                        }
                      },
                      "error": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                },
                "declarationErrors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "componentId",
                      "message"
                    ],
                    "properties": {
                      "componentId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "message": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAtMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lastAttemptAtMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
