{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/artifact-metadata.v1.schema.json",
  "title": "mHome Artifact Metadata v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "m", "s", "w", "h"],
      "properties": {
        "k": { "const": "i" },
        "m": { "type": "string", "pattern": "^image/[a-z0-9!#$&^_.+-]+$", "maxLength": 255 },
        "s": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "w": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "h": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "m", "s"],
      "properties": {
        "k": { "const": "a" },
        "m": { "type": "string", "pattern": "^audio/[a-z0-9!#$&^_.+-]+$", "maxLength": 255 },
        "s": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "d": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["k", "m", "s"],
      "properties": {
        "k": { "const": "f" },
        "m": {
          "type": "string",
          "pattern": "^(?!video/)[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
          "maxLength": 255
        },
        "s": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  ]
}
