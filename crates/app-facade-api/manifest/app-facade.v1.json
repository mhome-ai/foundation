      "managementPermission": "spaceMember",
      "owner": "scopeHub",
      "cloudPersistence": false
    },
    "user": {
      "contract": "mhome.user.profile.v1",
      "schema": "schema/user-profile.v1.schema.json",
      "requestTargets": [
        "/app/user/profile/get",
        "/app/user/profile/update",
        "/app/user/profile/avatar/prepare",
        "/app/user/profile/avatar/commit",
        "/app/user/profile/avatar/clear"
      ],
      "owner": "cloudAccount"
    },
