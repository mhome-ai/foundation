{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/artifact-upload.v1.schema.json",
  "title": "mHome Artifact Upload v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mimeType",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "IMAGE",
            "AUDIO",
            "VIDEO",
            "FILE"
          ]
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
          "not": {
            "pattern": "\\s"
          }
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "creationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          }
        },
        "identity": {
          "enum": [
            "auto",
            "man"
          ],
          "default": "auto"
        },
        "retention": {
          "enum": [
            "std",
            "tmp"
          ],
          "default": "std"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity": {
                "const": "man"
              }
            },
            "required": [
              "identity"
            ]
          },
          "then": {
            "required": [
              "creationId"
            ],
            "properties": {
              "creationId": {}
            }
          },
          "else": {
            "not": {
              "required": [
                "creationId"
              ],
              "properties": {
                "creationId": {}
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "IMAGE"
                },
                "mimeType": {
                  "type": "string",
                  "pattern": "^image/"
                },
                "durationMillis": false
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "AUDIO"
                },
                "mimeType": {
                  "type": "string",
                  "pattern": "^audio/"
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "VIDEO"
                },
                "mimeType": {
                  "type": "string",
                  "pattern": "^video/"
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "FILE"
                },
                "mimeType": {
                  "type": "string",
                  "not": {
                    "pattern": "^video/"
                  }
                },
                "durationMillis": false
              }
            }
          ]
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploadId",
        "url",
        "headers",
        "expiresAtUnixMs"
      ],
      "properties": {
        "uploadId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hostIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hostId",
            "publicKey"
          ],
          "properties": {
            "hostId": {
              "type": "string",
              "minLength": 1
            },
            "publicKey": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                },
                "y": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{43}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
