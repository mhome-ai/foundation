{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mhome.ai/app-facade/pod-discovery.v1.schema.json",
  "title": "Native-client BLE and LAN discovery snapshot (pods and Hosts)",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "scanning", "lanBrowsing", "adapter", "candidates"],
  "properties": {
    "revision": { "type": "integer", "minimum": 0 },
    "scanning": { "type": "boolean" },
    "lanBrowsing": { "type": "boolean" },
    "lanError": { "type": "string" },
    "adapter": { "$ref": "#/$defs/adapter" },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } }
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["ready", "poweredOff", "denied", "unavailable"] },
        "message": { "type": "string" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "kind",
        "transport",
        "name",
        "shortId",
        "rssi",
        "commissionable",
        "wifiConfigured",
        "lastSeenMs"
      ],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["pod", "host"] },
        "transport": { "enum": ["ble", "lan"] },
        "deviceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "shortId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "rssi": { "type": "integer" },
        "commissionable": { "type": "boolean" },
        "wifiConfigured": { "type": "boolean" },
        "lastSeenMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
