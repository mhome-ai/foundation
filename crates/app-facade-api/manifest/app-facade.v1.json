      "responses": {
        "/app/ui/customize/cards/catalog/package/get": "#/definitions/packageSnapshot",
        "/app/ui/customize/cards/catalog/package/create": "#/definitions/empty",
        "/app/ui/customize/cards/catalog/package/update": "#/definitions/empty",
        "/app/ui/customize/cards/catalog/release/list": "#/definitions/releaseList",
        "/app/ui/customize/cards/catalog/release/get": "#/definitions/release",
        "/app/ui/customize/cards/catalog/publish/prepare": "#/definitions/prepared",
        "/app/ui/customize/cards/catalog/publish/complete": "#/definitions/release",
        "/app/ui/customize/cards/selection/get": "#/definitions/selectionView",
        "/app/ui/customize/cards/install": "#/definitions/empty",
        "/app/ui/customize/cards/uninstall": "#/definitions/empty",
        "/app/ui/customize/cards/upgrade": "#/definitions/empty",
        "/app/ui/customize/cards/override/set": "#/definitions/empty",
        "/app/ui/customize/cards/override/reset": "#/definitions/empty"
      }
