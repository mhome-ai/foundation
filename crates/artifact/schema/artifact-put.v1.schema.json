{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/artifact-put.v1.schema.json",
  "title": "mHome Artifact Put v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "kind",
        "mimeType",
        "sizeBytes"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^meow-artifact://v2/",
          "maxLength": 2048
        },
        "kind": {
          "enum": [
            "IMAGE",
            "AUDIO",
            "VIDEO",
            "FILE"
          ]
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lifecycle": {
          "enum": [
            "std",
            "tmp",
            "man"
          ],
          "default": "std"
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "tmp"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "properties": {
              "expiresAtUnixMs": {}
            },
            "required": [
              "expiresAtUnixMs"
            ]
          },
          "else": {
            "not": {
              "properties": {
                "expiresAtUnixMs": {}
              },
              "required": [
                "expiresAtUnixMs"
              ]
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mimeType",
        "dataBase64"
      ],
      "properties": {
        "kind": {
          "enum": [
            "IMAGE",
            "AUDIO",
            "VIDEO",
            "FILE"
          ]
        },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$",
          "not": {
            "pattern": "\\s"
          }
        },
        "dataBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 70000000,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/][AQgw]==|[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=)?$",
          "not": {
            "pattern": "\\s"
          }
        },
        "durationMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lifecycle": {
          "enum": [
            "std",
            "tmp",
            "man"
          ],
          "default": "std"
        },
        "creationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "man"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "required": [
              "creationId"
            ],
            "properties": {
              "creationId": {}
            }
          },
          "else": {
            "not": {
              "required": [
                "creationId"
              ],
              "properties": {
                "creationId": {}
              }
            }
          }
        },
        {
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "IMAGE"
                },
                "mimeType": {
                  "type": "string",
                  "pattern": "^image/"
                },
                "durationMillis": false
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "AUDIO"
                },
                "mimeType": {
                  "type": "string",
                  "pattern": "^audio/"
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "VIDEO"
                },
                "mimeType": {
                  "type": "string",
                  "pattern": "^video/"
                }
              }
            },
            {
              "properties": {
                "kind": {
                  "const": "FILE"
                },
                "mimeType": {
                  "type": "string",
                  "not": {
                    "pattern": "^video/"
                  }
                },
                "durationMillis": false
              }
            }
          ]
        }
      ]
    },
    "response": {
      "$ref": "#/$defs/metadata"
    }
  }
}
