{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mhome.ai/core/host-permissions.schema.json",
  "title": "Host permission reports and local requests",
  "$defs": {
    "PermissionKey": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "enum": [
                "localNetwork",
                "bluetooth",
                "microphone",
                "reminders"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "targetBundleId"
          ],
          "properties": {
            "id": {
              "const": "automation"
            },
            "targetBundleId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "PermissionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permission",
        "processId",
        "state",
        "evidence",
        "observedAtMs",
        "error"
      ],
      "properties": {
        "permission": {
          "$ref": "#/$defs/PermissionKey"
        },
        "processId": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "unknown",
            "notDetermined",
            "granted",
            "notRequired",
            "denied",
            "restricted",
            "unsupported"
          ]
        },
        "evidence": {
          "enum": [
            "system",
            "platform",
            "probe",
            "unavailable"
          ]
        },
        "observedAtMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence": {
                "const": "probe"
              }
            }
          },
          "then": {
            "properties": {
              "observedAtMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "PermissionSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "PermissionUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "componentName",
        "feature",
        "reason",
        "observation",
        "error"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "componentName": {
          "type": "string",
          "minLength": 1
        },
        "feature": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "HostPermission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "permission",
        "subject",
        "uses",
        "requestComponentId",
        "supportedActions"
      ],
      "properties": {
        "permission": {
          "$ref": "#/$defs/PermissionKey"
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionSubject"
            },
            {
              "type": "null"
            }
          ]
        },
        "uses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PermissionUse"
          }
        },
        "requestComponentId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "supportedActions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "request",
              "openSettings"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "subject": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "uses": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "requestComponentId": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "supportedActions": {
                "not": {
                  "contains": {
                    "const": "request"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "PermissionDeclarationError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "message"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "HostPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "hostVersion",
        "platform",
        "observedAtMs",
        "permissions",
        "declarationErrors"
      ],
      "properties": {
        "hostId": {
          "type": "string",
          "minLength": 1
        },
        "hostVersion": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "observedAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostPermission"
          }
        },
        "declarationErrors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionDeclarationError"
          }
        }
      }
    },
    "HostPermissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "componentId",
        "permission"
      ],
      "properties": {
        "hostId": {
          "type": "string",
          "minLength": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "$ref": "#/$defs/PermissionKey"
        }
      }
    },
    "ServicePermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processId",
        "permissions"
      ],
      "properties": {
        "processId": {
          "type": "integer",
          "minimum": 1
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionObservation"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/HostPermissions"
    },
    {
      "$ref": "#/$defs/HostPermissionRequest"
    },
    {
      "$ref": "#/$defs/ServicePermissions"
    }
  ]
}
