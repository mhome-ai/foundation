{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mhome:messaging-api:frame:v3",
  "title": "mHome messaging management API conformance frame v3",
  "$ref": "#/$defs/frame",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "providerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "placement": {
      "enum": [
        "local",
        "cloud"
      ]
    },
    "extension": {
      "type": "object"
    },
    "audience": {
      "enum": [
        "personal",
        "shared"
      ]
    },
    "contentCapability": {
      "enum": [
        "text",
        "markdown",
        "image",
        "audio",
        "video",
        "file",
        "action"
      ]
    },
    "deliveryMode": {
      "enum": [
        "unrestricted",
        "session_window"
      ]
    },
    "managementOperation": {
      "enum": [
        "provider_account.list",
        "provider_account.update",
        "provider_account.delete",
        "provider_account.test",
        "provider_account.status",
        "account_grant.create",
        "account_grant.delete",
        "account_grant.list",
        "route.list",
        "route.update",
        "route.delete",
        "setup.options",
        "setup.start",
        "setup.status",
        "surface.list",
        "surface.dismiss",
        "surface.bind_code.create",
        "actor.link_code.create",
        "actor.link.list",
        "actor.link.delete"
      ]
    },
    "frontendProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "deprecated",
        "supportedPlacements"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "deprecated": {
          "type": "boolean"
        },
        "supportedPlacements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/placement"
          }
        }
      }
    },
    "providerMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "displayName",
        "placement",
        "deprecated",
        "available",
        "setupFlow",
        "audiences",
        "inboundCapabilities",
        "outboundCapabilities",
        "deliveryMode",
        "managementOperations",
        "providerData"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "displayName": {
          "$ref": "#/$defs/id"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "deprecated": {
          "type": "boolean"
        },
        "available": {
          "type": "boolean"
        },
        "disabledReason": {
          "$ref": "#/$defs/id"
        },
        "setupFlow": {
          "$ref": "#/$defs/id"
        },
        "audiences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/audience"
          }
        },
        "inboundCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentCapability"
          }
        },
        "outboundCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/contentCapability"
          }
        },
        "deliveryMode": {
          "$ref": "#/$defs/deliveryMode"
        },
        "managementOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/managementOperation"
          }
        },
        "providerData": {
          "$ref": "#/$defs/extension"
        }
      }
    },
    "providerAccountOwnership": {
      "enum": [
        "system",
        "user"
      ]
    },
    "providerAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "accountId",
        "ownership",
        "enabled",
        "status",
        "providerData"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "ownership": {
          "$ref": "#/$defs/providerAccountOwnership"
        },
        "displayName": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/id"
        },
        "statusMessage": {
          "$ref": "#/$defs/id"
        },
        "providerData": {
          "$ref": "#/$defs/extension"
        }
      }
    },
    "providerStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "enabled",
        "providerData"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "enabled": {
          "type": "boolean"
        },
        "providerData": {
          "$ref": "#/$defs/extension"
        }
      }
    },
    "accountGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "accountId",
        "tenantId",
        "scopeId",
        "userId",
        "default"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "tenantId": {
          "$ref": "#/$defs/id"
        },
        "scopeId": {
          "$ref": "#/$defs/id"
        },
        "userId": {
          "$ref": "#/$defs/id"
        },
        "default": {
          "type": "boolean"
        }
      }
    },
    "messagingRoute": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audience",
            "provider",
            "placement",
            "routeId",
            "accountId",
            "conversationId",
            "externalActorId",
            "tenantId",
            "userId",
            "scopeId",
            "enabled",
            "providerData"
          ],
          "properties": {
            "audience": {
              "const": "personal"
            },
            "provider": {
              "$ref": "#/$defs/providerId"
            },
            "placement": {
              "$ref": "#/$defs/placement"
            },
            "routeId": {
              "$ref": "#/$defs/id"
            },
            "accountId": {
              "$ref": "#/$defs/id"
            },
            "conversationId": {
              "$ref": "#/$defs/id"
            },
            "tenantId": {
              "$ref": "#/$defs/id"
            },
            "scopeId": {
              "$ref": "#/$defs/id"
            },
            "displayName": {
              "$ref": "#/$defs/id"
            },
            "enabled": {
              "type": "boolean"
            },
            "providerData": {
              "$ref": "#/$defs/extension"
            },
            "externalActorId": {
              "$ref": "#/$defs/id"
            },
            "userId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "audience",
            "provider",
            "placement",
            "routeId",
            "accountId",
            "conversationId",
            "tenantId",
            "scopeId",
            "boundByUserId",
            "enabled",
            "providerData"
          ],
          "properties": {
            "audience": {
              "const": "shared"
            },
            "provider": {
              "$ref": "#/$defs/providerId"
            },
            "placement": {
              "$ref": "#/$defs/placement"
            },
            "routeId": {
              "$ref": "#/$defs/id"
            },
            "accountId": {
              "$ref": "#/$defs/id"
            },
            "conversationId": {
              "$ref": "#/$defs/id"
            },
            "tenantId": {
              "$ref": "#/$defs/id"
            },
            "scopeId": {
              "$ref": "#/$defs/id"
            },
            "displayName": {
              "$ref": "#/$defs/id"
            },
            "enabled": {
              "type": "boolean"
            },
            "providerData": {
              "$ref": "#/$defs/extension"
            },
            "boundByUserId": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "setupAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "setupState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "providerData"
      ],
      "properties": {
        "setupId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "$ref": "#/$defs/id"
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "$ref": "#/$defs/setupAction"
        },
        "providerData": {
          "$ref": "#/$defs/extension"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "routeId": {
          "$ref": "#/$defs/id"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "surfaceState": {
      "enum": [
        "pending",
        "bound",
        "dismissed"
      ]
    },
    "messagingSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "accountId",
        "surfaceId",
        "state",
        "firstSeenAtMs",
        "lastSeenAtMs"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "surfaceId": {
          "$ref": "#/$defs/id"
        },
        "displayName": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "$ref": "#/$defs/surfaceState"
        },
        "scopeId": {
          "$ref": "#/$defs/id"
        },
        "firstSeenAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "lastSeenAtMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "challengeCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "command",
        "expiresAtMs"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "$ref": "#/$defs/id"
        },
        "expiresAtMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "actorLinkView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "linkId",
        "provider",
        "placement",
        "accountId",
        "externalUserId",
        "createdAtMs",
        "updatedAtMs"
      ],
      "properties": {
        "linkId": {
          "$ref": "#/$defs/id"
        },
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "externalUserId": {
          "$ref": "#/$defs/id"
        },
        "displayName": {
          "$ref": "#/$defs/id"
        },
        "createdAtMs": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAtMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mutationBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        }
      }
    },
    "providerListBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "frontendProviders"
      ],
      "properties": {
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "frontendProviders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frontendProvider"
          }
        }
      }
    },
    "providerPlacementBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        }
      }
    },
    "providerAccountUpdateBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "accountId",
        "data"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "data": {
          "$ref": "#/$defs/extension"
        }
      }
    },
    "providerAccountBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "accountId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "providerAccountTestBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "data"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "data": {
          "$ref": "#/$defs/extension"
        }
      }
    },
    "accountGrantBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "accountId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "routeListBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "audience": {
          "$ref": "#/$defs/audience"
        }
      }
    },
    "routeBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "routeId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "routeId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "routeUpdateBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "routeId",
        "scopeId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "routeId": {
          "$ref": "#/$defs/id"
        },
        "scopeId": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "setupStartBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "data"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "data": {
          "$ref": "#/$defs/extension"
        }
      }
    },
    "setupStatusBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "setupId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "setupId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "surfaceListBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "$ref": "#/$defs/surfaceState"
        }
      }
    },
    "surfaceBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "surfaceId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "surfaceId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "surfaceBindCodeBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "surfaceId",
        "scopeId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "surfaceId": {
          "$ref": "#/$defs/id"
        },
        "scopeId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "actorLinkCodeBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "accountId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "actorLinkListBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "accountId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "actorLinkDeleteBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "placement",
        "linkId"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/providerId"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "linkId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "providerListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "direction",
        "body"
      ],
      "properties": {
        "target": {
          "const": "/messaging/provider/list"
        },
        "direction": {
          "const": "request"
        },
        "body": {
          "$ref": "#/$defs/providerListBody"
        }
      }
    },
    "providerListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "direction",
        "body"
      ],
      "properties": {
        "target": {
          "const": "/messaging/provider/list"
        },
        "direction": {
          "const": "response"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "providers"
          ],
          "properties": {
            "providers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/providerMetadata"
              }
            }
          }
        }
      }
    },
    "providerAccountListRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "direction",
        "body"
      ],
      "properties": {
        "target": {
          "const": "/messaging/provider-account/list"
        },
        "direction": {
          "const": "request"
        },
        "body": {
          "$ref": "#/$defs/providerPlacementBody"
        }
      }
    },
    "providerAccountListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "direction",
        "body"
      ],
      "properties": {
        "target": {
          "const": "/messaging/provider-account/list"
        },
        "direction": {
          "const": "response"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accounts"
          ],
          "properties": {
            "accounts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/providerAccount"
              }
            }
          }
        }
      }
    },
    "providerAccountUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "direction",
        "body"
      ],
      "properties": {
        "target": {
          "const": "/messaging/provider-account/update"
        },
        "direction": {
          "const": "request"
        },
        "body": {
          "$ref": "#/$defs/providerAccountUpdateBody"
        }
      }
    },
    "providerAccountUpdateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "direction",
        "body"
      ],
      "properties": {
        "target": {
          "const": "/messaging/provider-account/update"
        },
        "direction": {
          "const": "response"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account"
          ],
          "properties": {
            "account": {
              "$ref": "#/$defs/providerAccount"
            }
          }
        }
      }
    },
    "providerAccountDeleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "direction",
        "body"
