{
  "contract": "mhome.host-management.v1",
  "transport": "native-client",
  "requiresSpace": false,
  "discoveryService": "_mhome-host._tcp",
  "methods": {
    "list": {
      "nativeMethod": "hostList",
      "desktopCommand": "host_list",
      "ipcMethod": "host.list"
    },
    "runtime": {
      "nativeMethod": "hostRuntime",
      "desktopCommand": "host_runtime",
      "ipcMethod": "host.runtime"
    },
    "claim": {
      "nativeMethod": "hostClaim",
      "desktopCommand": "host_claim",
      "ipcMethod": "host.claim"
    }
  },
  "actions": {
    "inspect": {
      "path": "/v1/runtime",
      "method": "POST"
    },
    "metrics": {
      "path": "/metrics",
      "method": "GET"
    },
    "plan": {
      "path": "/v1/runtime",
      "method": "POST"
    },
    "start": {
      "path": "/v1/runtime",
      "method": "POST"
    },
    "operation": {
      "path": "/v1/runtime",
      "method": "POST"
    },
    "restartOperation": {
      "path": "/v1/runtime",
      "method": "POST"
    }
  },
  "requestFields": [
    "hostId",
    "action",
    "components",
    "all",
    "planId",
    "operationId",
    "component"
  ],
  "listResponse": {
    "hosts": "array of HostListEntry",
    "entryRequired": [
      "hostId",
      "hostName",
      "isLocal",
      "reachable"
    ],
    "info": "HostInfo or null",
    "infoError": "string or null",
    "claimable": "boolean; verified empty-ACL challenge, not a permission result",
    "identityUnverified": "boolean; blocks TOFU and management after verification failure"
  },
  "runtimeResponse": {
    "metrics": "HostMetrics",
    "otherActions": "HostRuntimeResponse.data (envelope verified by Client)"
  },
  "networkPolicy": {
    "requiresLocalNetwork": true,
    "invalidateOnNetworkChange": true,
    "mutationsAutomaticallyRetried": false
  },
  "claimRequest": {
    "hostId": "non-empty string; no scope or endpoint accepted"
  },
  "claimResponse": {
    "claimed": "true only after Host persistence and cloud receipt commit",
    "hostId": "requested Host identity when supplied"
  }
}
