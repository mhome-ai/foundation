{
  "manifest": "mhome.artifact.v1",
  "contractVersion": "1.16.0",
  "uriPrefix": "meow-artifact://v3/",
  "kinds": [
    "image",
    "audio",
    "video",
    "file"
  ],
  "resolve": {
    "target": "/artifact/resolve",
    "schema": "schema/artifact-resolve.v1.schema.json",
    "schemaVersion": 1
  },
  "put": {
    "target": "/artifact/put",
    "schema": "schema/artifact-put.v1.schema.json",
    "schemaVersion": 1
  },
  "uploadPrepare": {
    "target": "/artifact/upload/prepare",
    "schema": "schema/artifact-upload.v1.schema.json",
    "schemaVersion": 1
  },
  "mediaReference": {
    "schema": "schema/media-reference.v1.schema.json",
    "schemaVersion": 1
  },
  "import": {
    "schema": "schema/artifact-import.v1.schema.json",
    "schemaVersion": 1
  },
  "delete": {
    "target": "/artifact/delete",
    "requestSchema": "schema/artifact-resolve.v1.schema.json#/$defs/request",
    "responseSchema": "schema/artifact-delete.v1.schema.json",
    "schemaVersion": 1
  },
  "uploadStart": {
    "target": "/artifact/upload/start",
    "schema": "schema/artifact-upload-start.v1.schema.json",
    "schemaVersion": 1
  },
  "uploadComplete": {
    "target": "/artifact/upload/complete",
    "schema": "schema/artifact-upload-complete.v1.schema.json",
    "schemaVersion": 1
  },
  "uploadCancel": {
    "target": "/artifact/upload/cancel",
    "schema": "schema/artifact-upload-cancel.v1.schema.json",
    "schemaVersion": 1
  },
  "uploadStream": {
    "contract": "contract/stream-upload-v1.md",
    "receiptSchema": "schema/artifact-upload-receipt.v1.schema.json",
    "schemaVersion": 1
  }
}
