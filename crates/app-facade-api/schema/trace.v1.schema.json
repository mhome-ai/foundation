            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "type",
          "timestamp",
          "automationId"
        ],
        "properties": {
          "type": {
            "const": "AUTOMATION_RESUME"
          },
          "timestamp": {
            "type": "integer",
            "minimum": 0
          },
          "automationId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      {
        "type": "object",
        "required": [
          "type",
          "timestamp",
          "widgetId"
