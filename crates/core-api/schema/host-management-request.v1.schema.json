        "proof": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
        "action",
        "proof"
      ],
      "properties": {
        "hostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
