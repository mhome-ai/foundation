{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/core/matter-plugin-management.v1.schema.json",
  "title": "Matter Plugin management payloads",
  "$defs": {
    "nodeDetailRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "matterNodeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "required": [
        "matterNodeIds"
      ]
    },
    "nodeDetailResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "matterNodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "node": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "message"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "matterNodeId",
              "node",
              "error"
            ]
          }
        }
      },
      "required": [
        "spaceId",
        "items"
      ]
    },
    "inventoryResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fabric": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "membershipComplete": {
          "type": "boolean"
        },
        "inventoryComplete": {
          "type": "boolean"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "matterNodeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "summary": {
                "anyOf": [
                  {
                    "type": "object"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "inventoryComplete": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "devices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sourceDeviceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "name": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "reachable": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "parentSourceDeviceId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "manufacturerName": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "productName": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "endpointId": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "endpointIds": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "capabilities": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "sourceDeviceId",
                    "name",
                    "reachable",
                    "parentSourceDeviceId",
                    "manufacturerName",
                    "productName",
                    "endpointId",
                    "endpointIds",
                    "capabilities"
                  ]
                }
              }
            },
            "required": [
              "matterNodeId",
              "summary",
              "inventoryComplete",
              "devices"
            ]
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "enum": [
                  "fabric",
                  "inventory"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "message"
            ]
          }
        }
      },
      "required": [
        "spaceId",
        "fabric",
        "membershipComplete",
        "inventoryComplete",
        "nodes",
        "errors"
      ]
    }
  }
}
