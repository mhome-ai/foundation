{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mhome.ai/schemas/app-facade/group.v1.schema.json",
  "$defs": {
    "ListGroupsInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memberType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "GetGroupsInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 100
        }
      },
      "required": [
        "ids"
      ]
    },
    "GroupPresentationInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "groupId"
      ]
    },
    "CreateGroupInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creationId": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "memberType": {
          "type": "string",
          "minLength": 1
        },
        "memberIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "creationId",
        "name",
        "memberType",
        "memberIds"
      ]
    },
    "RenameGroupInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "groupId",
        "name",
        "expectedRevision"
      ]
    },
    "UpdateGroupMembersInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "memberIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "groupId",
        "memberIds",
        "expectedRevision"
      ]
    },
    "DeleteGroupInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "groupId",
        "expectedRevision"
      ]
    },
    "GroupSummary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "memberType": {
          "type": "string",
          "minLength": 1
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "applyState": {
          "enum": [
            "applying",
            "ready",
            "failed",
            "deleting"
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 1
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "groupId",
        "name",
        "memberType",
        "memberCount",
        "revision",
        "applyState",
        "createdAt",
        "updatedAt"
      ]
    },
    "GroupDetail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "memberType": {
          "type": "string",
          "minLength": 1
        },
        "memberCount": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "applyState": {
          "enum": [
            "applying",
            "ready",
            "failed",
            "deleting"
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 1
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 1
        },
        "memberIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "memberCount": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "memberCount"
            ]
          }
        },
        "memberProblems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "memberId": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "memberId",
              "code",
              "message"
            ]
          }
        },
        "applicationProblem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "groupId",
        "name",
        "memberType",
        "memberCount",
        "revision",
        "applyState",
        "createdAt",
        "updatedAt",
        "memberIds",
        "capabilities",
        "memberProblems"
      ]
    },
    "GroupMutationOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "applyState": {
          "enum": [
            "applying",
            "ready",
            "failed",
            "deleting"
          ]
        },
        "applicationProblem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "groupId",
        "revision",
        "applyState"
      ]
    },
    "DeleteGroupOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "deleted": {
          "type": "boolean"
        },
        "applicationProblem": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "details": {}
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "groupId",
        "deleted"
      ]
    },
    "ListGroupsOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GroupSummary"
          }
        }
      },
      "required": [
        "spaceId",
        "groups"
      ]
    },
    "GetGroupsOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "requestedId": {
                "type": "string",
                "minLength": 1
              },
              "found": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "$ref": "#/$defs/GroupDetail"
              }
            },
            "required": [
              "requestedId",
              "found"
            ]
          }
        }
      },
      "required": [
        "spaceId",
        "items"
      ]
    }
  }
}
