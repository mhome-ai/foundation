{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/automation-presentation.v1.schema.json",
  "$defs": {
    "namesInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ids"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "namesOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automations"
      ],
      "properties": {
        "automations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
