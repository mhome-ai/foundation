{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge"
      ],
      "properties": {
        "challenge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accessToken"
      ],
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    }
  }
}
