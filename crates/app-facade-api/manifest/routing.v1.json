{
  "manifest": "mhome.app-facade.routing.v1",
  "contractVersion": "1.11.0",
  "targetPrefix": "/app/",
  "default": {
    "execution": "scopeMode",
    "relay": "directOnly"
  },
  "matching": "exactBeforePrefix",
  "placementJsonPointer": "/input/placement",
  "rules": {
    "cloudPrefixes": [
      "/app/scope/",
      "/app/inspire/"
    ],
    "cloudTargets": [
      "/app/agent/context/get",
      "/app/credit/record",
      "/app/hub/cache/clear",
      "/app/hub/get",
      "/app/hub/remove",
      "/app/plugin/catalog/list",
      "/app/system/feedback/submit",
      "/app/timeline/entity/latest/list"
    ],
    "scopeModeTargets": [
      "/app/artifact/resolve",
      "/app/scope/context/get"
    ],
    "hubPrefixes": [
      "/app/plugin/",
      "/app/interaction-flow/",
      "/app/object-storage/",
      "/app/runtime/",
      "/app/system/inventory/",
      "/app/system/clients/",
      "/app/system/host/"
    ],
    "requestPlacementPrefixes": [
      "/app/messaging/"
    ],
    "cloudRelayTargets": [
      "/app/plugin/candidate/list",
      "/app/plugin/detail/get",
      "/app/plugin/installed/list",
      "/app/object-storage/overview",
      "/app/object-storage/folders/create",
      "/app/object-storage/folders/get",
      "/app/object-storage/folders/update",
      "/app/object-storage/folders/list",
      "/app/object-storage/settings/update",
      "/app/system/inventory/get",
      "/app/system/clients/get",
      "/app/system/host/metrics/get",
      "/app/system/host/inspect",
      "/app/system/host/plan",
      "/app/system/host/start",
      "/app/system/host/operation/get",
      "/app/system/host/restart",
      "/app/system/host/permissions/get"
    ]
  }
}
