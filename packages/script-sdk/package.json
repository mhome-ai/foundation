{
  "name": "@meowlink/script",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "description": "TypeScript authoring contracts for MeowLink scripts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./host": { "types": "./dist/host.d.ts", "import": "./dist/host.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:types": "tsc -p tests/tsconfig.json",
    "test": "npm run build && npm run test:types && node --test tests/*.test.mjs"
  },
  "devDependencies": { "typescript": "6.0.3" }
}
