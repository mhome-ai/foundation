{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/camera-plugin-management.v1.schema.json",
  "title": "Camera Plugin management values",
  "oneOf": [
    {
      "$ref": "#/$defs/emptyRequest"
    },
    {
      "$ref": "#/$defs/deviceIdRequest"
    },
    {
      "$ref": "#/$defs/deviceSettingsUpdateRequest"
    },
    {
      "$ref": "#/$defs/managementSnapshot"
    },
    {
      "$ref": "#/$defs/deviceListResponse"
    },
    {
      "$ref": "#/$defs/connectionMutationResponse"
    },
    {
      "$ref": "#/$defs/deviceSettingsResponse"
    },
    {
      "$ref": "#/$defs/errorResponse"
    },
    {
      "$ref": "#/$defs/connectionIdRequest"
    },
    {
      "$ref": "#/$defs/connectionDisconnectRequest"
    },
    {
      "$ref": "#/$defs/connectionListResponse"
    },
    {
      "$ref": "#/$defs/providerListResponse"
    },
    {
      "$ref": "#/$defs/connectionDetailResponse"
    }
  ],
  "$defs": {
    "emptyRequest": {
      "type": "object",
      "additionalProperties": false
    },
    "deviceIdRequest": {
      "type": "object",
      "required": [
        "deviceId"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "providerCatalogItem": {
      "type": "object",
      "required": [
        "id",
        "displayName",
        "description",
        "supportsMultipleCameras"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "supportsMultipleCameras": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "cameraDevice": {
      "type": "object",
      "required": [
        "id",
        "name",
        "capabilities",
        "health",
        "connectionId",
        "resolutionStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "manufacturerName": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "health": {
          "enum": [
            "applying",
            "ready",
            "degraded",
            "error"
          ]
        },
        "lastError": {
          "type": "string",
          "minLength": 1
        },
        "connectionId": {
          "type": "string",
          "minLength": 1
        },
        "resolutionStatus": {
          "enum": [
            "unresolved",
            "ready",
            "failed"
          ]
        }
      },
      "additionalProperties": false
    },
    "onlineStateObservation": {
      "type": "object",
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "online",
            "offline"
          ]
        },
        "observedAt": {
          "type": "integer"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "managementSnapshot": {
      "type": "object",
      "required": [
        "providers",
        "devices",
        "onlineStates",
        "cameraSettings",
        "connections"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/providerCatalogItem"
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cameraDevice"
          }
        },
        "onlineStates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/onlineStateObservation"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cameraConnection"
          }
        },
        "cameraSettings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviceSettingsResponse"
          }
        }
      },
      "additionalProperties": false
    },
    "deviceListResponse": {
      "type": "object",
      "required": [
        "devices",
        "onlineStates"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cameraDevice"
          }
        },
        "onlineStates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/onlineStateObservation"
          }
        }
      },
      "additionalProperties": false
    },
    "connectionMutationResponse": {
      "type": "object",
      "required": [
        "deviceIds",
        "changed",
        "connectionId"
      ],
      "properties": {
        "deviceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "changed": {
          "type": "boolean"
        },
        "connectionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "errorResponse": {
      "type": "object",
      "required": [
        "ok",
        "reason",
        "detail"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "connectionIdRequest": {
      "type": "object",
      "required": [
        "connectionId"
      ],
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cameraConnection": {
      "type": "object",
      "required": [
        "id",
        "name",
        "deviceCount",
        "provider",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "deviceCount": {
          "type": "integer",
          "minimum": 0
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRefreshedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "cameraSettings": {
      "type": "object",
      "properties": {
        "watchMode": {
          "enum": [
            "off",
            "auto"
          ]
        },
        "objectDetectionMode": {
          "enum": [
            "off",
            "auto"
          ]
        },
        "personDetectionMode": {
          "enum": [
            "off",
            "auto"
          ]
        },
        "recordMode": {
          "enum": [
            "off",
            "event"
          ]
        },
        "preRollSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "postRollSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      },
      "additionalProperties": false,
      "required": [
        "watchMode",
        "objectDetectionMode",
        "personDetectionMode",
        "recordMode",
        "preRollSeconds",
        "postRollSeconds"
      ]
    },
    "cameraSettingsPatch": {
      "type": "object",
      "properties": {
        "watchMode": {
          "enum": [
            "off",
            "auto"
          ]
        },
        "objectDetectionMode": {
          "enum": [
            "off",
            "auto"
          ]
        },
        "personDetectionMode": {
          "enum": [
            "off",
            "auto"
          ]
        },
        "recordMode": {
          "enum": [
            "off",
            "event"
          ]
        },
        "preRollSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "postRollSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "deviceSettingsUpdateRequest": {
      "type": "object",
      "required": [
        "deviceId",
        "settings"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "settings": {
          "$ref": "#/$defs/cameraSettingsPatch"
        }
      },
      "additionalProperties": false
    },
    "deviceSettingsResponse": {
      "type": "object",
      "required": [
        "deviceId",
        "revision",
        "settings"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "settings": {
          "$ref": "#/$defs/cameraSettings"
        }
      },
      "additionalProperties": false
    },
    "connectionDisconnectRequest": {
      "type": "object",
      "required": [
        "connectionId",
        "expectedRevision"
      ],
      "properties": {
        "connectionId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "expectedDeviceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "connectionListResponse": {
      "type": "object",
      "required": [
        "connections"
      ],
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cameraConnection"
          }
        }
      },
      "additionalProperties": false
    },
    "providerListResponse": {
      "type": "object",
      "required": [
        "providers"
      ],
      "properties": {
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/providerCatalogItem"
          }
        }
      },
      "additionalProperties": false
    },
    "connectionDetailResponse": {
      "type": "object",
      "required": [
        "connection",
        "devices"
      ],
      "properties": {
        "connection": {
          "anyOf": [
            {
              "$ref": "#/$defs/cameraConnection"
            },
            {
              "type": "null"
            }
          ]
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cameraDevice"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
