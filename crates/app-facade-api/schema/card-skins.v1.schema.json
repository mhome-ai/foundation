{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.meowlink.app/card-skins.v1.json",
  "definitions": {
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "packageGet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        }
      },
      "required": [
        "packageId"
      ]
    },
    "packageCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "packageId",
        "name",
        "description"
      ]
    },
    "packageUpdate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "expectedRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "packageId",
        "expectedRevision",
        "name",
        "description"
      ]
    },
    "releaseGet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "maxLength": 128
        }
      },
      "required": [
        "packageId",
        "version"
      ]
    },
    "publishPrepare": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "type": "object"
        }
      },
      "required": [
        "manifest"
      ]
    },
    "publishComplete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uploadId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        }
      },
      "required": [
        "uploadId"
      ]
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "maxLength": 128
        }
      },
      "required": [
        "expectedRevision",
        "packageId",
        "version"
      ]
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "installationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "expectedRevision",
        "installationId"
      ]
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "installationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "maxLength": 128
        }
      },
      "required": [
        "expectedRevision",
        "installationId",
        "version"
      ]
    },
    "overrideSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "patternId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "installationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "rendererId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "expectedRevision",
        "patternId",
        "installationId",
        "rendererId",
        "config"
      ]
    },
    "overrideReset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "patternId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "expectedRevision",
        "patternId"
      ]
    },
    "packageInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageId",
        "authorUserId",
        "name",
        "description",
        "createdAt"
      ],
      "properties": {
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "authorUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "packageSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "value"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "value": {
          "$ref": "#/definitions/packageInfo"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "baseUrl",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "baseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^?#]+/$"
        },
        "manifest": {
          "$ref": "https://schemas.meowlink.app/card-skin-package.v1.json"
        }
      }
    },
    "releaseList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releases"
      ],
      "properties": {
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/release"
          }
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "spaceId",
        "releaseId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spaceId",
        "patternId",
        "installationId",
        "rendererId",
        "config"
      ],
      "properties": {
        "spaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "patternId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "installationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "rendererId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "config": {
          "type": "object"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installations",
        "overrides",
        "releases"
      ],
      "properties": {
        "installations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/installation"
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/override"
          }
        },
        "releases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/release"
          }
        }
      }
    },
    "selectionView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "selection"
      ],
      "properties": {
        "revision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "selection": {
          "$ref": "#/definitions/selection"
        }
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploadId",
        "expiresAt",
        "files"
      ],
      "properties": {
        "uploadId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "url",
              "headers"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "headers": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "Authorization",
                  "Content-Type"
                ],
                "properties": {
                  "Authorization": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "Content-Type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
