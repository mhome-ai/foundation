{
  "manifest": "mhome.app-facade.v1",
  "contractVersion": "1.61.0",
  "callSchema": "schema/facade-call.v1.schema.json",
  "routing": "manifest/routing.v1.json",
  "routingSchema": "schema/routing.v1.schema.json",
  "domains": {
    "artifact": {
      "contract": "mhome.artifact.v1",
      "requestTargets": [
        "/app/artifact/resolve",
        "/app/artifact/put",
        "/app/artifact/import",
        "/app/artifact/delete",
        "/app/artifact/upload/start",
        "/app/artifact/upload/complete",
        "/app/artifact/upload/cancel"
      ]
    },
    "hub": {
      "targets": "manifest/hub-targets.v1.json",
      "cloudStateTarget": "/app/hub/get",
      "nativeCompositeTarget": "/local/hub/get"
    },
    "messaging": {
      "targets": "manifest/targets.v1.json"
    },
    "pod": {
      "targets": "manifest/pod-targets.v1.json",
      "contract": "contract/pod-commissioning-v1.md",
      "listTarget": "/app/pod/list",
      "enrollmentTargets": [
        "/app/pod/enrollment/get",
        "/app/pod/space/enrollment/get"
      ],
      "renameTarget": "/app/pod/rename",
      "spaceInventoryTarget": "/app/pod/space/list",
      "directoryContract": "contract/pod-directory-v1.md"
    },
    "hostProvision": {
      "targets": "manifest/host-provision-targets.v1.json",
      "contract": "contract/host-provisioning-v1.md"
    },
    "plugin": {
      "extensionVersion": "v1",
      "targetPrefix": "/app/plugin",
      "catalogSchema": "schema/plugin-catalog.v1.schema.json",
      "exactRequestTargets": [
        "/app/plugin/catalog/list",
        "/app/plugin/enabled/list",
        "/app/plugin/detail/get",
        "/app/plugin/candidate/list",
        "/app/plugin/enable/start",
        "/app/plugin/enable/status",
        "/app/plugin/disable",
        "/app/plugin/profile/update"
      ],
      "eventTargets": [
        "/app/plugin/settings/changed"
      ],
      "extensionFamily": "/app/plugin/{nodeType}/{route...}",
      "extensionPriority": "after_exact"
    },
    "runtime": {
      "contract": "mhome.runtime.status.v1",
      "resourceTypes": [
        "nodeInstance",
        "nodeRuntime"
      ],
      "requestTargets": [
        "/app/runtime/status/list"
      ],
      "eventTargets": [
        "/app/runtime/status/changed"
      ]
    },
    "interactionFlow": {
      "schema": "schema/interaction-flow-app.v1.schema.json",
      "requestTargets": [
        "/app/interaction-flow/start",
        "/app/interaction-flow/resolve",
        "/app/interaction-flow/next",
        "/app/interaction-flow/back",
        "/app/interaction-flow/complete",
        "/app/interaction-flow/cancel"
      ],
      "sessionPersistence": "memory"
    },
    "system": {
      "contract": "mhome.system.instances.v1",
      "schema": "schema/system-instances.v1.schema.json",
      "hostsContract": "mhome.system.hosts.v1",
      "hostsSchema": "schema/system-hosts.v1.schema.json",
      "hostsRuntimeContract": "mhome.system.hosts.runtime.v1",
      "hostsRuntimeSchema": "schema/system-hosts-runtime.v1.schema.json",
      "requestTargets": [
        "/app/system/instances/get",
        "/app/system/clients/get",
        "/app/system/hosts/get",
        "/app/system/hosts/runtime",
        "/app/system/hosts/permissions"
      ]
    },
    "integration": {
      "capabilitySchema": "schema/capability-descriptor.v1.schema.json",
      "requestTargets": [
        "/app/integration/list",
        "/app/integration/detail/get",
        "/app/integration/detail/batch",
        "/app/integration/install",
        "/app/integration/uninstall",
        "/app/integration/connect",
        "/app/integration/disconnect",
        "/app/integration/installed/list",
        "/app/integration/capability/detail/get"
      ],
      "includeDocumentationDefault": true
    },
    "person": {
      "contract": "mhome.person.v1",
      "schema": "schema/person.v1.schema.json",
      "requestTargets": [
        "/app/person/backup/export",
        "/app/person/backup/import/commit",
        "/app/person/backup/import/start",
        "/app/person/backup/import/write",
        "/app/person/backup/read",
        "/app/person/backup/close",
        "/app/person/clusters/name",
        "/app/person/clusters/delete",
        "/app/person/clusters/list",
        "/app/person/get",
        "/app/person/list",
        "/app/person/reset",
        "/app/person/clusters/image",
        "/app/person/status",
        "/app/person/summary-images/batch-get"
      ],
      "managementPermission": "spaceMember",
      "owner": "scopeHub",
      "cloudPersistence": false
    },
    "user": {
      "contract": "mhome.user.profile.v1",
      "schema": "schema/user-profile.v1.schema.json",
      "requestTargets": [
        "/app/user/profile/get",
        "/app/user/profile/update",
        "/app/user/profile/avatar/prepare",
        "/app/user/profile/avatar/commit",
        "/app/user/profile/avatar/clear"
      ],
      "owner": "cloudAccount"
    },
    "hostManagement": {
      "accessTarget": "/app/host/access/issue",
      "accessSchema": "schema/host-access.v1.schema.json",
      "principal": "user",
      "issuer": "cloud",
      "firstClaimTransport": "directLanOnly",
      "authorizationTarget": "/app/host/authorization",
      "authorizationSchema": "schema/host-authorization.v1.schema.json",
      "listTarget": "/app/host/list",
      "requestTargets": [
        "/app/host/list",
        "/app/host/metrics",
        "/app/host/administrators/list",
        "/app/host/administrator/request",
        "/app/host/administrator/status",
        "/app/host/administrator/cancel",
        "/app/host/administrator/approve",
        "/app/host/administrator/reject",
        "/app/host/permissions/get",
        "/app/host/service/install",
        "/app/host/service/restart"
      ],
      "requestSchema": "schema/host-management.v1.schema.json",
      "directoryTarget": "/app/host/directory/list"
    },
    "clientAppearance": {
      "schema": "schema/client-appearance.v1.schema.json",
      "requestTargets": [
        "/app/client/appearance/report"
      ],
      "owner": "authenticatedClient",
      "persistence": "none"
    },
    "clientPage": {
      "schema": "schema/client-page.v1.schema.json",
      "requestTargets": [
        "/app/client/page/report",
        "/app/client/page/list",
        "/app/client/page/current",
        "/app/client/page/open"
      ],
      "owner": "authenticatedClient",
      "persistence": "none"
    },
    "cardSkins": {
      "contract": "contract/card-skins-v1.md",
      "packageSchema": "schema/card-skin-package.v1.schema.json",
      "requestSchema": "schema/card-skins.v1.schema.json",
      "requests": {
        "/app/card-skins/catalog/package/get": "#/definitions/packageGet",
        "/app/card-skins/catalog/package/create": "#/definitions/packageCreate",
        "/app/card-skins/catalog/package/update": "#/definitions/packageUpdate",
        "/app/card-skins/catalog/release/list": "#/definitions/packageGet",
        "/app/card-skins/catalog/release/get": "#/definitions/releaseGet",
        "/app/card-skins/catalog/publish/prepare": "#/definitions/publishPrepare",
        "/app/card-skins/catalog/publish/complete": "#/definitions/publishComplete",
        "/app/card-skins/selection/get": "#/definitions/empty",
        "/app/card-skins/install": "#/definitions/install",
        "/app/card-skins/uninstall": "#/definitions/uninstall",
        "/app/card-skins/upgrade": "#/definitions/upgrade",
        "/app/card-skins/override/set": "#/definitions/overrideSet",
        "/app/card-skins/override/reset": "#/definitions/overrideReset"
      },
      "responses": {
        "/app/card-skins/catalog/package/get": "#/definitions/packageSnapshot",
        "/app/card-skins/catalog/package/create": "#/definitions/empty",
        "/app/card-skins/catalog/package/update": "#/definitions/empty",
        "/app/card-skins/catalog/release/list": "#/definitions/releaseList",
        "/app/card-skins/catalog/release/get": "#/definitions/release",
        "/app/card-skins/catalog/publish/prepare": "#/definitions/prepared",
        "/app/card-skins/catalog/publish/complete": "#/definitions/release",
        "/app/card-skins/selection/get": "#/definitions/selectionView",
        "/app/card-skins/install": "#/definitions/empty",
        "/app/card-skins/uninstall": "#/definitions/empty",
        "/app/card-skins/upgrade": "#/definitions/empty",
        "/app/card-skins/override/set": "#/definitions/empty",
        "/app/card-skins/override/reset": "#/definitions/empty"
      }
    }
  },
  "authorization": "manifest/authorization.v1.json",
  "delegatedCallSchema": "schema/delegated-call.v1.schema.json",
  "responseSchema": "schema/facade-response.v1.schema.json"
}
