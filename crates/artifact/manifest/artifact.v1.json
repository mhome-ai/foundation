{
  "manifest": "mhome.artifact.v1",
  "contractVersion": "1.8.0",
  "uriPrefix": "meow-artifact://v1/",
  "kinds": [
    "image",
    "audio",
    "video",
    "file"
  ],
  "resolve": {
    "target": "/artifact/resolve",
    "schema": "schema/artifact-resolve.v1.schema.json",
    "schemaVersion": 1
  },
  "put": {
    "target": "/artifact/put",
    "schema": "schema/artifact-put.v1.schema.json",
    "schemaVersion": 1
  },
  "uploadPrepare": {
    "target": "/artifact/upload/prepare",
    "schema": "schema/artifact-upload.v1.schema.json",
    "schemaVersion": 1
  },
  "mediaReference": {
    "schema": "schema/media-reference.v1.schema.json",
    "schemaVersion": 1
  },
  "import": {
    "schema": "schema/artifact-import.v1.schema.json",
    "schemaVersion": 1
  },
  "persist": {
    "target": "/artifact/persist",
    "requestSchema": "schema/artifact-resolve.v1.schema.json#/$defs/request",
    "responseSchema": "schema/artifact-put.v1.schema.json#/$defs/response",
    "schemaVersion": 1
  },
  "delete": {
    "target": "/artifact/delete",
    "requestSchema": "schema/artifact-resolve.v1.schema.json#/$defs/request",
    "responseSchema": "schema/artifact-delete.v1.schema.json",
    "schemaVersion": 1
  }
}
