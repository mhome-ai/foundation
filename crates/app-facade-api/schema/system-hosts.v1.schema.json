{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "scopeId",
    "observedAtMs",
    "hosts"
  ],
  "properties": {
    "contract": {
      "const": "mhome.system.hosts.v1"
    },
    "scopeId": {
      "type": "string"
    },
    "observedAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostId",
          "env",
          "hostName",
          "hostType",
          "source",
          "reachable",
          "claimable",
          "info",
          "authorization",
          "challenge"
        ],
        "properties": {
          "hostId": {
            "type": "string"
          },
          "hostName": {
            "type": "string"
          },
          "hostType": {
            "type": "string"
          },
          "source": {
            "enum": [
              "local",
              "mdns"
            ]
          },
          "reachable": {
            "type": "boolean"
          },
          "claimable": {
            "type": "boolean"
          },
          "info": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "data",
              "observedAtMs",
              "lastAttemptAtMs",
              "stale",
              "errorCode"
            ],
            "properties": {
              "status": {
                "enum": [
                  "ok",
                  "unavailable",
                  "unsupported",
                  "notQueried"
                ]
              },
              "data": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "hostId",
                      "hostName",
                      "hostType",
                      "os",
                      "osVersion",
                      "cpu",
                      "memory",
                      "disk",
                      "gpus"
                    ],
                    "properties": {
                      "hostId": {
                        "type": "string"
                      },
                      "hostName": {
                        "type": "string"
                      },
                      "hostType": {
                        "type": "string"
                      },
                      "os": {
                        "type": "string"
                      },
                      "osVersion": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cpu": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "arch",
                          "logicalCores",
                          "model"
                        ],
                        "properties": {
                          "arch": {
                            "type": "string"
                          },
                          "logicalCores": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "model": {
                            "type": "string"
                          }
                        }
                      },
                      "memory": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "totalBytes"
                        ],
                        "properties": {
                          "totalBytes": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      },
                      "disk": {
                        "anyOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "totalBytes"
                            ],
                            "properties": {
                              "totalBytes": {
                                "type": "integer",
                                "minimum": 0
                              }
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "gpus": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "vendor",
                            "name",
                            "memoryBytes"
                          ],
                          "properties": {
                            "vendor": {
                              "type": "string"
                            },
                            "name": {
                              "type": "string"
                            },
                            "memoryBytes": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observedAtMs": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lastAttemptAtMs": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stale": {
                "type": "boolean"
              },
              "errorCode": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "authorization": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "hostId",
                  "hostKeyId",
                  "env",
                  "mode",
                  "generation",
                  "claim"
                ],
                "properties": {
                  "hostId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "hostKeyId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "env": {
                    "enum": [
                      "prod",
                      "dev",
                      "e2e"
                    ]
                  },
                  "mode": {
                    "enum": [
                      "admin",
                      "spaceSelf",
                      "spaceDep"
                    ]
                  },
                  "generation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "claim": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "userIds"
                        ],
                        "properties": {
                          "kind": {
                            "const": "admin"
                          },
                          "userIds": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "space"
                        ],
                        "properties": {
                          "kind": {
                            "const": "space"
                          },
                          "space": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "tenantId",
                              "scopeId"
                            ],
                            "properties": {
                              "tenantId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                              },
                              "scopeId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 256
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "challenge": {
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "enum": [
              "prod",
              "dev",
              "e2e"
            ]
          }
        }
      }
    }
  }
}
