{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.meowlink.app/card-skin-package.v1.json",
  "title": "MeowLink Card skin package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "version",
    "name",
    "description",
    "apiVersion",
    "renderers",
    "entry",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 128
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "apiVersion": {
      "const": 1
    },
    "renderers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/renderer"
      },
      "maxItems": 128
    },
    "entry": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+\\.mjs$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/file"
      },
      "maxItems": 128
    }
  },
  "definitions": {
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patternId",
        "contractId",
        "contractVersion"
      ],
      "properties": {
        "patternId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contractId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "supportedPatterns",
        "detail",
        "configSchema"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "supportedPatterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/pattern"
          }
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "custom",
                "builtin",
                "none"
              ]
            }
          }
        },
        "configSchema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "packageId",
        "version",
        "name",
        "description",
        "apiVersion",
        "renderers",
        "entry"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "apiVersion": {
          "const": 1
        },
        "renderers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/renderer"
          },
          "maxItems": 128
        },
        "entry": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
