{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mhome.ai/app-facade/pod-commission.v1.schema.json",
  "title": "Native-client pod commissioning session snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "revision",
    "state",
    "candidate",
    "expiresAtMs"
  ],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "connecting",
        "awaiting_code",
        "securing",
        "reading_info",
        "awaiting_wifi",
        "joining_wifi",
        "discovering_lan",
        "connecting_lan",
        "awaiting_authorization",
        "issuing",
        "delivering",
        "activating",
        "completed",
        "failed",
        "timed_out"
      ]
    },
    "candidate": {
      "$ref": "pod-discovery.v1.schema.json#/$defs/candidate"
    },
    "expiresAtMs": {
      "type": "integer",
      "minimum": 0
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "model",
        "firmwareVersion",
        "wifiConfigured",
        "dependentHost"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "firmwareVersion": {
          "type": "string",
          "minLength": 1
        },
        "wifiConfigured": {
          "type": "boolean"
        },
        "dependentHost": {
          "type": "boolean"
        }
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ssid",
          "rssi",
          "secured"
        ],
        "properties": {
          "ssid": {
            "type": "string",
            "minLength": 1
          },
          "rssi": {
            "type": "integer"
          },
          "secured": {
            "type": "boolean"
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "userName",
        "scopes",
        "defaultScopeId"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1
        },
        "userName": {
          "type": "string"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scopeId",
              "name",
              "local",
              "owner"
            ],
            "properties": {
              "scopeId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "local": {
                "type": "boolean"
              },
              "owner": {
                "type": "boolean"
              }
            }
          }
        },
        "defaultScopeId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "podId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "reprovision"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "bluetooth_unavailable",
            "device_busy",
            "disconnected",
            "lan_unavailable",
            "device_mismatch",
            "code_rejected",
            "code_locked",
            "wifi_auth_failed",
            "wifi_not_found",
            "wifi_failed",
            "issue_failed",
            "delivery_failed",
            "activation_failed",
            "session_timeout"
          ]
        },
        "message": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "clientMode": {
      "enum": [
        "user",
        "space"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "failed",
              "timed_out"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {}
        },
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "enum": [
                "failed",
                "timed_out",
                "awaiting_code",
                "awaiting_wifi"
              ]
            }
          }
        }
      },
      "then": {
        "not": {
          "properties": {
            "error": {}
          },
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "awaiting_code"
          }
        },
        "required": [
          "error"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "const": "code_rejected"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "awaiting_wifi"
          }
        },
        "required": [
          "error"
        ]
      },
      "then": {
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "wifi_auth_failed",
                  "wifi_not_found",
                  "wifi_failed"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "awaiting_authorization"
          }
        }
      },
      "then": {
        "properties": {
          "authorization": {}
        },
        "required": [
          "authorization"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        },
        "not": {
          "properties": {
            "mode": {}
          },
          "required": [
            "mode"
          ]
        }
      },
      "then": {
        "properties": {
          "podId": {},
          "clientMode": {}
        },
        "required": [
          "podId",
          "clientMode"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {}
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "properties": {
                "podId": {}
              },
              "required": [
                "podId"
              ]
            },
            {
              "properties": {
                "authorization": {}
              },
              "required": [
                "authorization"
              ]
            },
            {
              "properties": {
                "clientMode": {}
              },
              "required": [
                "clientMode"
              ]
            }
          ]
        }
      }
    }
  ]
}
