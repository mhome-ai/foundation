{
  "manifest": "mhome.core.v1",
  "contractVersion": "1.59.0",
  "protocols": {
    "agentGateway": {
      "submitTarget": "/agent/submit",
      "replyTarget": "/{nodeType}/agent/reply"
    },
    "llm": {
      "completeTarget": "/llm/complete"
    },
    "node": {
      "managementEventTarget": "/node/app/event",
      "managementEventAppTarget": "/app/plugin/event",
      "managementContract": "contract/plugin-management-v1.md",
      "settingsChangedTarget": "/node/settings/changed",
      "statusContract": "mhome.node.status.v1",
      "runtimeVersion": "v1",
      "interactionFlowSchema": "schema/interaction-flow-node.v1.schema.json",
      "interactionFlowDefinitionTarget": "/{nodeType}/interaction-flow/definition",
      "interactionFlowExecuteTarget": "/{nodeType}/interaction-flow/execute",
      "interactionFlowCompleteTarget": "/{nodeType}/interaction-flow/complete",
      "interactionFlowSubmissionStatusTarget": "/{nodeType}/interaction-flow/submission/status",
      "interactionFlowSubmissionRetryTarget": "/{nodeType}/interaction-flow/submission/retry",
      "interactionFlowCloseTarget": "/{nodeType}/interaction-flow/close",
      "metadataTarget": "/node/metadata",
      "metadataSchema": "schema/node-metadata.v1.schema.json",
      "metadataContract": "contract/node-metadata-v1.md"
    },
    "audioBridgePlugin": {
      "version": "v1",
      "nodeType": "audiobridge",
      "appTargetPrefix": "/app/plugin/audiobridge/",
      "runtimeTargetPrefix": "/audiobridge/app/",
      "routes": {
        "deviceSnapshot": "device/snapshot",
        "deviceRefresh": "device/refresh",
        "devicePair": "device/pair",
        "deviceUnpair": "device/unpair",
        "deviceSettingsGet": "device/settings/get",
        "deviceSettingsUpdate": "device/settings/update",
        "smartSpeakerSnapshot": "smart-speaker/snapshot",
        "smartSpeakerCreate": "smart-speaker/create",
        "smartSpeakerUpdate": "smart-speaker/update",
        "smartSpeakerRemove": "smart-speaker/remove"
      },
      "agentReplyTarget": "/audiobridge/agent/reply"
    },
    "messaging": {
      "normalizedInboundSchema": "schema/normalized-inbound.v4.schema.json",
      "commandsSchema": "schema/messaging-commands.v1.schema.json"
    },
    "storage": {
      "version": "storage.v1"
    },
    "hostDelivery": {
      "externalProtocolVersion": 25,
      "requestKind": "deliveryRequested",
      "connectionControlKind": "connectionControlRequested",
      "acceptanceBoundaries": [
        "connectionQueue",
        "provider"
      ],
      "outcomes": [
        "accepted",
        "skipped",
        "failed",
        "unknown"
      ]
    },
    "hostPermissions": {
      "schema": "schema/host-permissions.schema.json",
      "statusPath": "/v1/permissions",
      "requestPath": "/internal/permissions/request",
      "settingsPath": "/internal/permissions/open-settings"
    }
  },
  "hostManagement": {
    "contract": "contract/host-management-v1.json",
    "requestSchema": "schema/host-management-request.v1.schema.json"
  }
}
