{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mhome.ai/schema/artifact-resolve.v1.schema.json",
  "title": "mHome Artifact Resolve v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "pattern": "^meow-artifact://v1/", "maxLength": 2048 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "kind", "mimeType", "sizeBytes", "delivery"],
      "properties": {
        "uri": { "type": "string", "pattern": "^meow-artifact://v1/", "maxLength": 2048 },
        "kind": { "enum": ["IMAGE", "AUDIO", "FILE"] },
        "mimeType": { "type": "string", "minLength": 3, "maxLength": 255 },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "width": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "height": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "durationMillis": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "delivery": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "dataUrl"],
              "properties": {
                "type": { "const": "DATA_URL" },
                "dataUrl": { "type": "string", "pattern": "^data:[^;,]+;base64,.+$" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "url", "expiresAtUnixMs"],
              "properties": {
                "type": { "const": "SIGNED_URL" },
                "url": { "type": "string", "pattern": "^https?://" },
                "expiresAtUnixMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
              }
            }
          ]
        }
      }
    }
  }
}
