{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "plugins",
    "platformErrors"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeType",
          "displayName",
          "description",
          "componentId",
          "bindingCardinality",
          "id",
          "serviceId",
          "kind",
          "platforms",
          "versions"
        ],
        "additionalProperties": false,
        "properties": {
          "nodeType": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "bindingCardinality": {
            "enum": [
              "single",
              "multiple"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "serviceId": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "core",
              "extension"
            ]
          },
          "platforms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "versions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "platformErrors": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
