{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "plugins"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nodeType",
          "displayName",
          "description",
          "componentId",
          "bindingCardinality"
        ],
        "additionalProperties": false,
        "properties": {
          "nodeType": {
            "type": "string",
            "minLength": 1
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "bindingCardinality": {
            "enum": [
              "single",
              "multiple"
            ]
          }
        }
      }
    }
  }
}
