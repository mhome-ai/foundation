          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "start"
        },
        "planId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostId",
